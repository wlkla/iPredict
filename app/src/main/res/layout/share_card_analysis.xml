<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android='http://schemas.android.com/apk/res/android'
    android:layout_width='match_parent'
    android:layout_height='wrap_content'
    android:orientation='vertical'
    android:padding='18dp'
    android:background='@drawable/share_card_bg'>

    <TextView
        android:id='@+id/shareAnalysisTitle'
        android:layout_width='wrap_content'
        android:layout_height='wrap_content'
        android:text='周期分析'
        android:textColor='@color/white'
        android:textSize='18sp'
        android:textStyle='bold' />

    <TextView
        android:id='@+id/shareAnalysisSubtitle'
        android:layout_width='wrap_content'
        android:layout_height='wrap_content'
        android:layout_marginTop='4dp'
        android:text='事件：'
        android:textColor='@color/white'
        android:textSize='13sp'
        android:alpha='0.9' />

    <LinearLayout
        android:layout_width='match_parent'
        android:layout_height='wrap_content'
        android:layout_marginTop='14dp'
        android:orientation='horizontal'
        android:weightSum='3'>

        <LinearLayout
            android:layout_width='0dp'
            android:layout_height='wrap_content'
            android:layout_weight='1'
            android:orientation='vertical'>
            <TextView
                android:id='@+id/shareAnalysisAvg'
                android:layout_width='wrap_content'
                android:layout_height='wrap_content'
                android:text='28天'
                android:textColor='@color/white'
                android:textSize='16sp'
                android:textStyle='bold' />
            <TextView
                android:layout_width='wrap_content'
                android:layout_height='wrap_content'
                android:text='平均周期'
                android:textColor='@color/white'
                android:textSize='12sp'
                android:alpha='0.8' />
        </LinearLayout>

        <LinearLayout
            android:layout_width='0dp'
            android:layout_height='wrap_content'
            android:layout_weight='1'
            android:orientation='vertical'>
            <TextView
                android:id='@+id/shareAnalysisSamples'
                android:layout_width='wrap_content'
                android:layout_height='wrap_content'
                android:text='6次'
                android:textColor='@color/white'
                android:textSize='16sp'
                android:textStyle='bold' />
            <TextView
                android:layout_width='wrap_content'
                android:layout_height='wrap_content'
                android:text='样本数'
                android:textColor='@color/white'
                android:textSize='12sp'
                android:alpha='0.8' />
        </LinearLayout>

        <LinearLayout
            android:layout_width='0dp'
            android:layout_height='wrap_content'
            android:layout_weight='1'
            android:orientation='vertical'>
            <TextView
                android:id='@+id/shareAnalysisLatest'
                android:layout_width='wrap_content'
                android:layout_height='wrap_content'
                android:text='--'
                android:textColor='@color/white'
                android:textSize='16sp'
                android:textStyle='bold' />
            <TextView
                android:layout_width='wrap_content'
                android:layout_height='wrap_content'
                android:text='最近记录'
                android:textColor='@color/white'
                android:textSize='12sp'
                android:alpha='0.8' />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id='@+id/shareAnalysisIntervals'
        android:layout_width='match_parent'
        android:layout_height='wrap_content'
        android:layout_marginTop='12dp'
        android:text='最近间隔：'
        android:textColor='@color/white'
        android:textSize='13sp'
        android:alpha='0.85' />

    <LinearLayout
        android:layout_width='match_parent'
        android:layout_height='wrap_content'
        android:layout_marginTop='12dp'
        android:orientation='vertical'
        android:background='@drawable/share_card_chip'
        android:padding='10dp'>

        <ImageView
            android:id='@+id/shareLineImage'
            android:layout_width='match_parent'
            android:layout_height='180dp'
            android:scaleType='fitCenter'
            android:adjustViewBounds='true' />

        <ImageView
            android:id='@+id/shareBarImage'
            android:layout_width='match_parent'
            android:layout_height='160dp'
            android:layout_marginTop='8dp'
            android:scaleType='fitCenter'
            android:adjustViewBounds='true' />

        <ImageView
            android:id='@+id/sharePieImage'
            android:layout_width='match_parent'
            android:layout_height='180dp'
            android:layout_marginTop='8dp'
            android:scaleType='fitCenter'
            android:adjustViewBounds='true' />
    </LinearLayout>

    <TextView
        android:id='@+id/shareAnalysisFooter'
        android:layout_width='match_parent'
        android:layout_height='wrap_content'
        android:layout_marginTop='12dp'
        android:text='iPredict · 记录周期 · 更懂自己'
        android:textColor='@color/white'
        android:textSize='12sp'
        android:alpha='0.7'
        android:gravity='end' />

</LinearLayout>
