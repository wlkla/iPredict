<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android='http://schemas.android.com/apk/res/android'
    xmlns:app='http://schemas.android.com/apk/res-auto'
    android:layout_width='match_parent'
    android:layout_height='match_parent'
    android:background='@color/page_bg'>

    <ScrollView
        android:layout_width='match_parent'
        android:layout_height='match_parent'
        android:fillViewport='true'>

        <LinearLayout
            android:layout_width='match_parent'
            android:layout_height='wrap_content'
            android:orientation='vertical'
            android:padding='14dp'
            android:paddingBottom='16dp'>

            <LinearLayout
                android:layout_width='match_parent'
                android:layout_height='wrap_content'
                android:gravity='center_vertical'
                android:orientation='horizontal'>

                <LinearLayout
                    android:layout_width='0dp'
                    android:layout_height='wrap_content'
                    android:layout_weight='1'
                    android:orientation='vertical'>

                    <TextView
                        android:layout_width='wrap_content'
                        android:layout_height='wrap_content'
                        android:text='周期时间'
                        android:textColor='@color/text_primary'
                        android:textSize='18sp'
                        android:textStyle='bold' />

                </LinearLayout>

                <ImageView
                    android:id='@+id/btnShareCountdown'
                    android:layout_width='24dp'
                    android:layout_height='24dp'
                    android:contentDescription='share'
                    android:src='@drawable/ic_share_hd'
                    app:tint='@color/text_primary' />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id='@+id/cardCountdown'
                android:layout_width='match_parent'
                android:layout_height='wrap_content'
                android:layout_marginTop='12dp'
                app:cardBackgroundColor='@color/page_bg'
                app:cardCornerRadius='22dp'
                app:cardElevation='0dp'
                app:strokeColor='@color/neu_stroke'
                app:strokeWidth='1dp'>

                <LinearLayout
                    android:layout_width='match_parent'
                    android:layout_height='wrap_content'
                    android:orientation='vertical'
                    android:padding='18dp'>

                    <TextView
                        android:id='@+id/txtCountdownLabel'
                        android:layout_width='wrap_content'
                        android:layout_height='wrap_content'
                        android:text='倒计时'
                        android:textColor='@color/text_secondary'
                        android:textSize='17sp' />

                    <FrameLayout
                        android:layout_width='228dp'
                        android:layout_height='228dp'
                        android:layout_gravity='center_horizontal'
                        android:layout_marginTop='8dp'
                        android:clipToPadding='false'
                        android:padding='10dp'>

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id='@+id/progressCountdown'
                            android:layout_width='match_parent'
                            android:layout_height='match_parent'
                            android:indeterminate='false'
                            android:max='28'
                            android:progress='24'
                            app:indicatorColor='@color/mint'
                            app:indicatorSize='208dp'
                            app:indicatorTrackGapSize='0dp'
                            app:trackColor='@color/mint_track'
                            app:trackThickness='7dp' />

                        <LinearLayout
                            android:layout_width='wrap_content'
                            android:layout_height='wrap_content'
                            android:layout_gravity='center'
                            android:gravity='bottom'
                            android:orientation='horizontal'>

                            <TextView
                                android:id='@+id/txtDaysLeft'
                                android:layout_width='wrap_content'
                                android:layout_height='wrap_content'
                                android:text='4'
                                android:textColor='@color/text_primary'
                                android:textSize='62sp' />

                            <TextView
                                android:layout_width='wrap_content'
                                android:layout_height='wrap_content'
                                android:layout_marginBottom='16dp'
                                android:text='天'
                                android:textColor='@color/text_secondary'
                                android:textSize='24sp' />
                        </LinearLayout>
                    </FrameLayout>

                    <View
                        android:layout_width='70dp'
                        android:layout_height='2dp'
                        android:layout_marginTop='6dp'
                        android:background='@color/divider' />

                    <TextView
                        android:id='@+id/txtNextDate'
                        android:layout_width='wrap_content'
                        android:layout_height='wrap_content'
                        android:layout_marginTop='10dp'
                        android:text='下一个预期事件日期：2026-02-16'
                        android:textColor='@color/text_primary'
                        android:textSize='18sp' />

                    <TextView
                        android:id='@+id/txtSummary'
                        android:layout_width='wrap_content'
                        android:layout_height='wrap_content'
                        android:layout_marginTop='8dp'
                        android:text='平均周期 28 天，距离上次已 24 天'
                        android:textColor='@color/text_secondary'
                        android:textSize='14sp' />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width='match_parent'
                android:layout_height='wrap_content'
                android:layout_marginTop='12dp'
                app:cardBackgroundColor='@color/page_bg'
                app:cardCornerRadius='22dp'
                app:cardElevation='0dp'
                app:strokeColor='@color/neu_stroke'
                app:strokeWidth='1dp'>

                <LinearLayout
                    android:layout_width='match_parent'
                    android:layout_height='wrap_content'
                    android:minHeight='170dp'
                    android:orientation='vertical'
                    android:padding='16dp'>

                    <TextView
                        android:id='@+id/txtInsightTitle'
                        android:layout_width='wrap_content'
                        android:layout_height='wrap_content'
                        android:text='周期洞察'
                        android:textColor='@color/text_primary'
                        android:textSize='17sp'
                        android:textStyle='bold' />

                    <LinearLayout
                        android:layout_width='match_parent'
                        android:layout_height='wrap_content'
                        android:layout_marginTop='12dp'
                        android:orientation='horizontal'>

                        <LinearLayout
                            android:layout_width='0dp'
                            android:layout_height='wrap_content'
                            android:layout_weight='1'
                            android:orientation='vertical'>

                            <TextView
                                android:layout_width='wrap_content'
                                android:layout_height='wrap_content'
                                android:text='最近记录'
                                android:textColor='@color/text_secondary'
                                android:textSize='12sp' />

                            <TextView
                                android:id='@+id/txtInsightLatest'
                                android:layout_width='wrap_content'
                                android:layout_height='wrap_content'
                                android:layout_marginTop='4dp'
                                android:text='--'
                                android:textColor='@color/text_primary'
                                android:textSize='15sp'
                                android:textStyle='bold' />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width='0dp'
                            android:layout_height='wrap_content'
                            android:layout_weight='1'
                            android:orientation='vertical'>

                            <TextView
                                android:layout_width='wrap_content'
                                android:layout_height='wrap_content'
                                android:text='样本量'
                                android:textColor='@color/text_secondary'
                                android:textSize='12sp' />

                            <TextView
                                android:id='@+id/txtInsightSamples'
                                android:layout_width='wrap_content'
                                android:layout_height='wrap_content'
                                android:layout_marginTop='4dp'
                                android:text='0'
                                android:textColor='@color/text_primary'
                                android:textSize='15sp'
                                android:textStyle='bold' />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width='0dp'
                            android:layout_height='wrap_content'
                            android:layout_weight='1'
                            android:orientation='vertical'>

                            <TextView
                                android:layout_width='wrap_content'
                                android:layout_height='wrap_content'
                                android:text='平均间隔'
                                android:textColor='@color/text_secondary'
                                android:textSize='12sp' />

                            <TextView
                                android:id='@+id/txtInsightAverage'
                                android:layout_width='wrap_content'
                                android:layout_height='wrap_content'
                                android:layout_marginTop='4dp'
                                android:text='--'
                                android:textColor='@color/text_primary'
                                android:textSize='15sp'
                                android:textStyle='bold' />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id='@+id/txtInsightRecentIntervals'
                        android:layout_width='match_parent'
                        android:layout_height='wrap_content'
                        android:layout_marginTop='14dp'
                        android:text='最近间隔：--'
                        android:textColor='@color/text_secondary'
                        android:textSize='13sp' />

                    <LinearLayout
                        android:layout_width='match_parent'
                        android:layout_height='wrap_content'
                        android:layout_marginTop='12dp'
                        android:gravity='center_vertical'
                        android:orientation='horizontal'>

                        <com.google.android.material.button.MaterialButton
                            android:id='@+id/btnGoDates'
                            style='@style/Widget.MaterialComponents.Button.OutlinedButton'
                            android:layout_width='0dp'
                            android:layout_height='42dp'
                            android:layout_weight='1'
                            android:minHeight='0dp'
                            android:text='查看日期'
                            android:textColor='@color/text_primary'
                            app:cornerRadius='16dp'
                            app:strokeColor='@color/neu_stroke'
                            app:strokeWidth='1dp' />

                        <Space
                            android:layout_width='10dp'
                            android:layout_height='1dp' />

                        <com.google.android.material.button.MaterialButton
                            android:id='@+id/btnGoAnalysis'
                            style='@style/Widget.MaterialComponents.Button.OutlinedButton'
                            android:layout_width='0dp'
                            android:layout_height='42dp'
                            android:layout_weight='1'
                            android:minHeight='0dp'
                            android:text='查看分析'
                            android:textColor='@color/text_primary'
                            app:cornerRadius='16dp'
                            app:strokeColor='@color/neu_stroke'
                            app:strokeWidth='1dp' />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id='@+id/btnAddToday'
                style='@style/Widget.IPredict.ActionButton'
                android:layout_width='match_parent'
                android:layout_height='52dp'
                android:layout_marginTop='14dp'
                android:layout_marginBottom='8dp'
                android:minHeight='0dp'
                android:text='是今天哦🥰'
                app:cornerRadius='22dp' />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
