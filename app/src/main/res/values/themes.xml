<?xml version='1.0' encoding='utf-8'?>
<resources xmlns:tools='http://schemas.android.com/tools'>
    <style name='Theme.IPredict' parent='Theme.Material3.DayNight.NoActionBar'>
        <item name='android:statusBarColor'>@android:color/transparent</item>
        <item name='android:navigationBarColor'>@color/page_bg</item>
        <item name='android:windowLightStatusBar' tools:targetApi='m'>true</item>
    </style>

    <style name='Widget.IPredict.SmallButton' parent='Widget.Material3.Button.OutlinedButton'>
        <item name='android:layout_width'>112dp</item>
        <item name='android:layout_height'>42dp</item>
        <item name='android:textColor'>@color/text_primary</item>
        <item name='backgroundTint'>@color/card_bg</item>
        <item name='strokeColor'>@color/divider</item>
        <item name='strokeWidth'>1.5dp</item>
        <item name='shapeAppearance'>@style/ShapeAppearance.Material3.SmallComponent</item>
        <item name='iconTint'>@color/text_primary</item>
        <item name='iconGravity'>textStart</item>
        <item name='iconPadding'>6dp</item>
        <item name='android:textSize'>13sp</item>
    </style>

    <style name='Widget.IPredict.ActionButton' parent='Widget.Material3.Button.OutlinedButton'>
        <item name='android:layout_width'>match_parent</item>
        <item name='android:layout_height'>52dp</item>
        <item name='android:textColor'>@color/text_primary</item>
        <item name='android:textSize'>18sp</item>
        <item name='backgroundTint'>@color/page_bg</item>
        <item name='strokeColor'>@color/neu_stroke</item>
        <item name='strokeWidth'>1dp</item>
        <item name='rippleColor'>@android:color/transparent</item>
        <item name='elevation'>0dp</item>
        <item name='shapeAppearance'>@style/ShapeAppearance.Material3.LargeComponent</item>
    </style>

    <style name='ThemeOverlayIPredictDatePicker' parent='ThemeOverlay.Material3.MaterialCalendar'>
        <item name='colorPrimary'>#4CA9A3</item>
        <item name='colorOnPrimary'>@color/white</item>
        <item name='colorSurface'>@color/white</item>
        <item name='colorOnSurface'>@color/text_primary</item>
        <item name='shapeAppearanceSmallComponent'>@style/ShapeAppearance.Material3.SmallComponent</item>
    </style>

    <style name='ThemeOverlayIPredictDialog' parent='ThemeOverlay.Material3.MaterialAlertDialog'>
        <item name='colorSurface'>@color/card_bg</item>
        <item name='android:textColorPrimary'>@color/text_primary</item>
        <item name='android:textColorSecondary'>@color/text_secondary</item>
        <item name='colorPrimary'>@color/mint</item>
    </style>
</resources>
