<?xml version='1.0' encoding='utf-8'?>
<layer-list xmlns:android='http://schemas.android.com/apk/res/android'>
    <item android:left='1dp' android:top='2dp' android:right='1dp' android:bottom='0dp'>
        <shape android:shape='rectangle'>
            <corners android:radius='22dp' />
            <solid android:color='@color/action_shadow' />
        </shape>
    </item>

    <item>
        <shape android:shape='rectangle'>
            <corners android:radius='22dp' />
            <gradient
                android:angle='270'
                android:startColor='@color/action_highlight'
                android:endColor='@color/action_surface' />
            <stroke
                android:width='1.5dp'
                android:color='@color/divider' />
        </shape>
    </item>
</layer-list>
